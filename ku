    <!-- ================= JAVASCRIPT LOGIC ================= -->
    <script>
        // API KEY 설정 (실제 환경에서는 런타임 제공)
        const apiKey = "";

        // 탭 전환 핸들러
        function switchTab(tabName) {
            const pages = ['home', 'auto', 'board'];
            pages.forEach(p => {
                const el = document.getElementById(`page-${p}`);
                const btn = document.getElementById(`nav-${p}`);
                if (p === tabName) {
                    el.classList.remove('hidden');
                    if (btn) {
                        btn.classList.add('text-amber-400');
                        btn.classList.remove('text-slate-300');
                    }
                } else {
                    el.classList.add('hidden');
                    if (btn) {
                        btn.classList.remove('text-amber-400');
                        btn.classList.add('text-slate-300');
                    }
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 지수 백오프 방식 API 호출 함수
        async function fetchGeminiWithBackoff(url, payload) {
            const maxRetries = 5;
            let delay = 1000;

            for (let i = 0; i < maxRetries; i++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        return await response.json();
                    }
                } catch (err) {
                    // silent retry
                }
                await new Promise(res => setTimeout(res, delay));
                delay *= 2; // 1s, 2s, 4s, 8s, 16s
            }
            throw new Error("API 요청 실패");
        }

        // 위험성평가 자동 생성 실행
        async function generateAssessment() {
            const task = document.getElementById('input-task').value.trim();
            const tools = document.getElementById('input-tools').value.trim();
            const detail = document.getElementById('input-detail').value.trim();

            if (!task || !detail) {
                alert("작업명과 세부 작업 내용을 작성해 주세요.");
                return;
            }

            const loadingSpinner = document.getElementById('loading-spinner');
            const resultContainer = document.getElementById('result-container');

            loadingSpinner.classList.remove('hidden');
            resultContainer.classList.add('hidden');

            // 프롬프트 구성
            const promptText = `
                대한민국 산업안전보건법 위험성평가 지침에 근거하여 다음 작업에 대한 위험성평가표 데이터를 작성해줘.
                
                [작업 정보]
                - 작업명: ${task}
                - 사용 기구/장비: ${tools || '없음'}
                - 세부 작업 내용: ${detail}

                요청사항: 세부 작업 단계별로 3가지 이상의 유해위험요인을 분석하고 아래 JSON 형식 규격에 맞춰 응답해줘.
            `;

            // JSON Schema 구조 정의
            const schema = {
                type: "OBJECT",
                properties: {
                    assessmentList: {
                        type: "ARRAY",
                        items: {
                            type: "OBJECT",
                            properties: {
                                step: { type: "STRING", description: "세부 작업단계" },
                                hazard: { type: "STRING", description: "유해·위험요인" },
                                currentAction: { type: "STRING", description: "현재의 안전조치" },
                                frequency: { type: "INTEGER", description: "빈도 (1~5)" },
                                severity: { type: "INTEGER", description: "강도 (1~5)" },
                                countermeasure: { type: "STRING", description: "위험성 감소대책 (개선안)" }
                            },
                            required: ["step", "hazard", "currentAction", "frequency", "severity", "countermeasure"]
                        }
                    }
                },
                required: ["assessmentList"]
            };

            const payload = {
                contents: [{ parts: [{ text: promptText }] }],
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: schema
                }
            };

            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

            try {
                const data = await fetchGeminiWithBackoff(endpoint, payload);
                const resultText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                
                if (!resultText) throw new Error("결과 응답 없음");
                
                const parsedData = JSON.parse(resultText);
                renderAssessmentResult(task, tools, parsedData.assessmentList);

            } catch (error) {
                console.error(error);
                alert("위험성평가표 자동 생성 도중 오류가 발생했습니다. 다시 시도해주세요.");
            } finally {
                loadingSpinner.classList.add('hidden');
            }
        }

        // 결과를 테이블로 렌더링
        function renderAssessmentResult(task, tools, list) {
            document.getElementById('res-task-name').innerText = task;
            document.getElementById('res-tools').innerText = tools || '해당 없음';
            document.getElementById('res-date').innerText = new Date().toLocaleDateString('ko-KR');

            const tbody = document.getElementById('res-table-body');
            tbody.innerHTML = '';

            list.forEach((item, index) => {
                const riskScore = item.frequency * item.severity;
                let riskBadgeClass = 'bg-green-100 text-green-800';
                if (riskScore >= 9) riskBadgeClass = 'bg-red-100 text-red-800 font-bold';
                else if (riskScore >= 5) riskBadgeClass = 'bg-amber-100 text-amber-800';

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="border border-slate-400 p-2 text-center font-medium">${index + 1}</td>
                    <td class="border border-slate-400 p-2 font-medium">${escapeHtml(item.step)}</td>
                    <td class="border border-slate-400 p-2 text-slate-800">${escapeHtml(item.hazard)}</td>
                    <td class="border border-slate-400 p-2 text-slate-600">${escapeHtml(item.currentAction)}</td>
                    <td class="border border-slate-400 p-2 text-center">
                        <span class="px-2 py-0.5 rounded text-xs inline-block ${riskBadgeClass}">
                            ${riskScore}점 (${item.frequency}x${item.severity})
                        </span>
                    </td>
                    <td class="border border-slate-400 p-2 text-indigo-900 font-medium">${escapeHtml(item.countermeasure)}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('result-container').classList.remove('hidden');
            document.getElementById('result-container').scrollIntoView({ behavior: 'smooth' });
        }

        function resetAutoForm() {
            document.getElementById('input-task').value = '';
            document.getElementById('input-tools').value = '';
            document.getElementById('input-detail').value = '';
            document.getElementById('result-container').classList.add('hidden');
        }

        // HTML 문자열 이스케이프
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }

        // ================= 게시판 관련 기능 =================
        function viewPost(badge, title, author, date, views) {
            document.getElementById('post-modal-badge').innerText = badge;
            document.getElementById('post-modal-title').innerText = title;
